                "steps": [
                    {
                        "id": "1",
                        "name": "Sample ID",
                        "description": "Add Sample ID column name .\ntoolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_text_file_with_recurring_lines/9.5+galaxy3"
                    },
                    {
                        "id": "2",
                        "name": "header for total area",
                        "description": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_text_file_with_recurring_lines/9.5+galaxy3"
                    },
                    {
                        "id": "3",
                        "name": "Color Deconvolution",
                        "description": "Performs colour deconvolution using the H-E-DAB (HED) transformation, separating the image into individual stain channels. Channel 1 = Hematoxylin, Channel 2 = Eosin/target stain, Channel 3 = Residuals. Higher pixel intensity indicates lower stain concentration.\ntoolshed.g2.bx.psu.edu/repos/imgteam/color_deconvolution/ip_color_deconvolution/0.9+galaxy0"
                    },
                    {
                        "id": "4",
                        "name": "Show image info",
                        "description": "toolshed.g2.bx.psu.edu/repos/imgteam/image_info/ip_imageinfo/5.7.1+galaxy1"
                    },
                    {
                        "id": "5",
                        "name": "Split Image Channels for Staining Detection",
                        "description": "Splits multi-channel image into single-channel images. Extracts the target stain channel from the split image collection. Default index: 1 (Channel 2). Verify this corresponds to your stain of interest before running the workflow. The pixel data type is preserved.\ntoolshed.g2.bx.psu.edu/repos/imgteam/split_image/ip_split_image/2.3.5+galaxy0"
                    },
                    {
                        "id": "6",
                        "name": "Width Extraction",
                        "description": "Grep1"
                    },
                    {
                        "id": "7",
                        "name": "Height Extraction",
                        "description": "Grep1"
                    },
                    {
                        "id": "8",
                        "name": "Collection: Extract Stain Channel from Sub-Collections",
                        "description": "This step extracts the second image (usually the relevant stain channel) from each sub-collection in a collection of collections. Please verify the selected channel is correct before proceeding. The current index is set to extract dataset 2.\n__EXTRACT_DATASET__"
                    },
                    {
                        "id": "9",
                        "name": "Text transformation",
                        "description": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_sed_tool/9.5+galaxy3"
                    },
                    {
                        "id": "10",
                        "name": "Text transformation",
                        "description": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_sed_tool/9.5+galaxy3"
                    },
                    {
                        "id": "11",
                        "name": "Threshold Stain Channel Collection",
                        "description": "Applies a threshold to the selected stain channel to segment stained areas for quantification.\nTool only process tiff files with 1 channel. \ntoolshed.g2.bx.psu.edu/repos/imgteam/2d_auto_threshold/ip_threshold/0.25.2+galaxy0"
                    },
                    {
                        "id": "12",
                        "name": "Paste",
                        "description": "Paste1"
                    },
                    {
                        "id": "13",
                        "name": "Generate ROIs of stained region",
                        "description": "This step detects CD11b positive regions from the binary mask and generates polygon ROIs for each stained blob. ROIs can be uploaded to OMERO for visual validation of the threshold.\ntoolshed.g2.bx.psu.edu/repos/imgteam/imagej2_analyze_particles_binary/imagej2_analyze_particles_binary/20240614+galaxy0"
                    },
                    {
                        "id": "14",
                        "name": "Extract Image Features",
                        "description": "Extracts quantitative features (e.g., mean intensity) from the thresholded image to support staining analysis.\n\n\ntoolshed.g2.bx.psu.edu/repos/imgteam/2d_feature_extraction/ip_2d_feature_extraction/0.25.2+galaxy1"
                    },
                    {
                        "id": "15",
                        "name": "Compute",
                        "description": "toolshed.g2.bx.psu.edu/repos/devteam/column_maker/Add_a_column1/2.1+galaxy0"
                    },
                    {
                        "id": "16",
                        "name": "Prepare Header Source Dataset",
                        "description": "Extracts a dataset that will be used to obtain the header row for the final concatenated tabular file in a subsequent step.\n__EXTRACT_DATASET__"
                    },
                    {
                        "id": "17",
                        "name": "Extract",
                        "description": "Show tail1"
                    },
                    {
                        "id": "18",
                        "name": "Extract element identifiers",
                        "description": "toolshed.g2.bx.psu.edu/repos/iuc/collection_element_identifiers/collection_element_identifiers/0.0.2"
                    },
                    {
                        "id": "19",
                        "name": "Cut",
                        "description": "Cut1"
                    },
                    {
                        "id": "20",
                        "name": "Header Extraction",
                        "description": "Extracting header from source dataset to use in the final tabular file. \nShow beginning1"
                    },
                    {
                        "id": "21",
                        "name": "Collapse Collection into one file",
                        "description": "Allows to collapse a collection of tabular files with the individual samples quantification into one tabular file. \ntoolshed.g2.bx.psu.edu/repos/nml/collapse_collections/collapse_dataset/5.1.0"
                    },
                    {
                        "id": "22",
                        "name": "Collapse Collection",
                        "description": "toolshed.g2.bx.psu.edu/repos/nml/collapse_collections/collapse_dataset/5.1.0"
                    },
                    {
                        "id": "23",
                        "name": "Paste header with Sample ID",
                        "description": "Combined the Sample ID with the header of the remaining columns.\nPaste1"
                    },
                    {
                        "id": "24",
                        "name": "Paste Sample Names with Tabular Results",
                        "description": "This step joins a list of sample names with their corresponding quantification results. It pastes both files side by side, ensuring that each sample name is aligned with the correct row of the quantification table.\nPaste1"
                    },
                    {
                        "id": "25",
                        "name": "Concatenate datasets",
                        "description": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_cat/9.5+galaxy3"
                    },
                    {
                        "id": "26",
                        "name": "Tabular: Staining Feature Results",
                        "description": "This final output file contains the merged measurement results for all samples, and can be used for further statistical analysis.\ncat1"
                    },
                    {
                        "id": "27",
                        "name": "Paste",
                        "description": "Paste1"
                    },
                    {
                        "id": "28",
                        "name": "Percent area computation",
                        "description": "Computes the proportion of positive signal area relative to total image area, expressed as percentage.\ntoolshed.g2.bx.psu.edu/repos/devteam/column_maker/Add_a_column1/2.1+galaxy0"
                    }
                ],
